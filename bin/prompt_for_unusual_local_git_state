#!/usr/bin/env ruby
# Hacky wrapper file to call the shell script. By default, installed gems run scripts as if they are Ruby,
# and do not respect the shebang line (e.g. a bash shebang). This file is a workaround to call the shell script directly.

bin_dir = File.expand_path(File.dirname(__FILE__))
shell_script_path = File.join(bin_dir, 'prompt_for_unusual_local_git_state.sh')

system("#{shell_script_path}")
exit $?.exitstatus
